{
  "mcpServers": {
    "opensearch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--with", "mcp<2.2.0", "opensearch-mcp-server-py"]
    },
    "openstack": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with", "mcp<2.2.0",
        "--refresh-package", "openstack-mcp-guarded",
        "--from", "git+https://github.com/barozek90/openstack-mcp-guarded.git",
        "openstack-mcp-guarded"
      ],
      "env": { "CLOUD_NAME": "", "DEBUG_MODE": "false" }
    }
  }
}
